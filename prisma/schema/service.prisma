model Service {
  id            String   @id @default(uuid())
  name          String
  description   String
  price         Float
  category      String   @default("General")
  technicianId  String
  technician    TechnicianProfile @relation(fields: [technicianId], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings Booking[]
}
