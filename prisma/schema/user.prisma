enum Role {
  CUSTOMER
  TECHNICIAN
  ADMIN
}


model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(CUSTOMER)
  isBanned  Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  technicianProfile TechnicianProfile?
  bookings          Booking[]
  reviews           Review[]
}
