# Environment variables for FixItNow Backend

NODE_ENV=development
PORT=5000

# Database
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/fixitnow?schema=public"

# JWT
JWT_SECRET="fixitnow-super-secret-key-change-in-production"
JWT_ACCESS_SECRET="fixitnow-access-secret-key"
JWT_REFRESH_SECRET="fixitnow-refresh-secret-key"
JWT_EXPIRES_IN="7d"

# Stripe
STRIPE_SECRET_KEY="Stripe_Secret_Key"
STRIPE_WEBHOOK_SECRET="Stript_Web_Hook_Secret"

# Client URL (for Stripe redirect)
CLIENT_URL="http://localhost:3000"
